# 复制成 .env 后填自己的配置。.env 已在 .gitignore 里，不会被提交。

# ── 模型（OpenAI 兼容端点）──
MODEL_NAME=
MODEL_API_KEY=
# 官方 OpenAI 可留空；国内模型一般要填，例如：
#   DeepSeek   https://api.deepseek.com/v1
#   阿里百炼    https://dashscope.aliyuncs.com/compatible-mode/v1
#   月之暗面    https://api.moonshot.cn/v1
#   智谱       https://open.bigmodel.cn/api/paas/v4
#   火山方舟    https://ark.cn-beijing.volces.com/api/v3
MODEL_BASE_URL=

# 单次调用的读超时（秒）。卡住时的闸门 —— 默认 300；慢模型可调大。
# ⚠️ 是"两次读到数据之间"的超时，一直在吐字的流不会被误杀。
# MODEL_TIMEOUT_S=300

# 注：本原型没有 fake / 离线模式，所有 LLM 调用都走真实模型。
